# Copy to .env.local. Every value is optional; missing integrations show as "not configured".
# Folder of Markdown notes, one subfolder per project (default: ./vault)
VAULT_ROOT=
# JSON map of project slug -> repo path, used by the Sessions console
VENTURE_REPOS={}
# SQLite path for app state (default: data/app.db)
APP_DB_PATH=
# Linear personal API key (Settings -> API) for task counts and approved issue creation
LINEAR_API_KEY=
# Path to a Google OAuth client JSON for Gmail drafts / Calendar read
GOOGLE_OAUTH_JSON=
TZ=
